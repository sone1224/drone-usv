# 복사해서 .env 로 저장하고 값을 채우세요. .env 는 커밋하지 마세요.
PORT=3000
# 제안서 작성(sample)에 쓰는 Anthropic API 키
ANTHROPIC_API_KEY=
# 사용할 모델 ID — 최신 목록: https://docs.claude.com/en/docs/about-claude/models (예: claude-sonnet-5-5)
ANTHROPIC_MODEL=
# 제안서처럼 긴 작업용(비우면 ANTHROPIC_MODEL 사용, 예: claude-opus-5-5)
ANTHROPIC_MODEL_COMPLEX=
ANTHROPIC_MAX_TOKENS=16000
# 제안서 작성(Claude 호출) 접속 IP별 시간당 최대 횟수
SAMPLE_LIMIT_PER_HOUR=30
# 설정하면 HTTP Basic 인증(아이디 아무거나, 비밀번호 = 이 값). 배포(NODE_ENV=production) 시 필수
APP_PASSWORD=
# 사내망 전용 등 의도적으로 인증 없이 production 운영할 때만 1
ALLOW_NO_AUTH=
# (선택) 부산 실지도 운용 화면용 Google Maps JavaScript API 키. 비우면 OpenStreetMap·Esri 위성 지도 사용
# 브라우저에 노출되므로 Google Cloud 콘솔에서 HTTP 리퍼러(배포 도메인)로 제한할 것
GOOGLE_MAPS_API_KEY=
# 데이터 폴더(기본 ./data)
DATA_DIR=data
# docker compose + Caddy 배포 시 접속 도메인(예: usv.example.co.kr) — DNS가 서버를 가리켜야 HTTPS 발급
DOMAIN=
